generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("member")
  createdAt DateTime @default(now())
  purchases Purchase[]
  journalEntries JournalEntry[]
  agendaEntries AgendaEntry[]
  chatMessages ChatMessage[]
}

model Product {
  id          String   @id
  name        String
  type        String
  price       Int
  currency    String
  description String
  active      Boolean  @default(true)
  purchases   Purchase[]
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  productId String
  provider  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  day        Int
  gratitude  String?
  reflection String?
  actions    String?
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model AgendaEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  gratitude String?
  intention String?
  action    String?
  habits    String?
  user      User     @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
